{
  "name": "@gbesse/camunda-jev-connector",
  "version": "0.1.0",
  "description": "Camunda 8 decision worker, Modeler template and BPMN example using Jev.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/camunda-jev-connector.git"
  },
  "files": [
    "src",
    "nodes",
    "app.js",
    "api.js",
    "packs",
    "examples",
    "element-templates",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck --strict --target ES2022 --module NodeNext docs/public-api-types.mts",
    "demo": "node examples/demo.mjs"
  },
  "dependencies": {
    "@camunda8/orchestration-cluster-api": "9.1.5",
    "@gbesse/decisionpacks": "git+https://github.com/gbesse/decisionpacks.git#3c90b6e667c16653b9a6ae00b376df9bddbd8461"
  },
  "devDependencies": {
    "@camunda/zeebe-element-templates-json-schema": "0.46.0",
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    }
  }
}
